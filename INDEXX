<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Suma Jayanjali Nalla - Computer Science student and aspiring software developer portfolio.">
  <title>Suma Jayanjali Nalla | Software Developer</title>
  <style>
    :root {
      --ink: #17231d;
      --muted: #64736a;
      --paper: #f5f7f1;
      --card: #ffffff;
      --line: #dfe6dc;
      --accent: #c8f169;
      --accent-dark: #789c38;
      --dark: #17231d;
      --shadow: 0 18px 50px rgba(23, 35, 29, .08);
      --radius: 22px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--paper);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.6;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; }
    .page { display: grid; grid-template-columns: 280px 1fr; min-height: 100vh; }

    .sidebar {
      background: var(--dark);
      color: #eef4e9;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 32px 28px;
      position: sticky;
      top: 0;
      height: 100vh;
    }
    .monogram {
      align-items: center;
      background: var(--accent);
      border-radius: 12px;
      color: var(--dark);
      display: flex;
      font-size: 1.1rem;
      font-weight: 900;
      height: 44px;
      justify-content: center;
      letter-spacing: -.08em;
      width: 44px;
    }
    .brand { display: flex; gap: 12px; align-items: center; }
    .brand-name { font-size: .92rem; font-weight: 800; letter-spacing: .02em; }
    .brand-role { color: #9baa9d; font-size: .72rem; margin-top: 2px; }
    .nav { display: grid; gap: 7px; margin: 74px 0 auto; }
    .nav a {
      border-left: 2px solid transparent;
      color: #aab8ad;
      font-size: .78rem;
      letter-spacing: .08em;
      padding: 11px 0 11px 14px;
      text-transform: uppercase;
      transition: .2s ease;
    }
    .nav a:hover, .nav a.active { border-left-color: var(--accent); color: var(--accent); }
    .sidebar-footer { color: #819087; font-size: .73rem; }
    .socials { display: flex; gap: 10px; margin-top: 14px; }
    .socials a { border: 1px solid #3a493e; border-radius: 50%; display: grid; height: 32px; place-items: center; transition: .2s; width: 32px; }
    .socials a:hover { background: var(--accent); border-color: var(--accent); color: var(--dark); }

    main { min-width: 0; }
    .mobile-bar { display: none; }
    .section { margin: 0 auto; max-width: 1060px; padding: 100px 64px; }
    .eyebrow {
      align-items: center;
      color: var(--accent-dark);
      display: flex;
      font-size: .72rem;
      font-weight: 800;
      gap: 10px;
      letter-spacing: .16em;
      margin-bottom: 18px;
      text-transform: uppercase;
    }
    .eyebrow::before { background: var(--accent-dark); content: ""; height: 2px; width: 28px; }
    .hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: 50px; min-height: 600px; align-items: center; }
    h1 { font-size: clamp(3.2rem, 7vw, 6.7rem); letter-spacing: -.09em; line-height: .94; max-width: 680px; }
    h1 span { color: var(--accent-dark); }
    .hero-copy { color: var(--muted); font-size: 1.03rem; margin: 28px 0 34px; max-width: 500px; }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .button {
      align-items: center;
      border: 1px solid var(--dark);
      border-radius: 999px;
      display: inline-flex;
      font-size: .82rem;
      font-weight: 800;
      gap: 9px;
      padding: 13px 20px;
      transition: .2s ease;
    }
    .button.primary { background: var(--dark); color: white; }
    .button.primary:hover { background: var(--accent-dark); border-color: var(--accent-dark); }
    .button.secondary { border-color: var(--line); color: var(--muted); }
    .button.secondary:hover { border-color: var(--dark); color: var(--dark); }
    .hero-art { align-items: center; display: flex; justify-content: center; position: relative; }
    .portrait-card { background: var(--accent); border-radius: 44% 56% 50% 50% / 48% 42% 58% 52%; height: 370px; overflow: hidden; position: relative; transform: rotate(4deg); width: min(100%, 330px); }
    .portrait-card::before { border: 2px solid rgba(23,35,29,.22); border-radius: 50%; content: ""; height: 275px; left: 28px; position: absolute; top: 40px; width: 275px; }
    .portrait-initials { bottom: 28px; color: var(--dark); font-size: 8.5rem; font-weight: 900; left: 40px; letter-spacing: -.16em; line-height: 1; position: absolute; }
    .availability { background: var(--card); border: 1px solid var(--line); border-radius: 14px; bottom: 12px; box-shadow: var(--shadow); display: flex; gap: 10px; left: -12px; padding: 13px 16px; position: absolute; transform: rotate(-6deg); }
    .status-dot { background: #81b33d; border-radius: 50%; height: 9px; margin-top: 6px; width: 9px; }
    .availability small { color: var(--muted); display: block; font-size: .68rem; }
    .availability strong { font-size: .78rem; }

    .section-heading { align-items: end; display: flex; justify-content: space-between; margin-bottom: 38px; }
    h2 { font-size: clamp(2rem, 4vw, 3.2rem); letter-spacing: -.07em; line-height: 1; }
    .section-intro { color: var(--muted); max-width: 400px; }
    .about-grid { display: grid; gap: 56px; grid-template-columns: 1fr 1fr; }
    .about-grid p { color: var(--muted); margin-bottom: 18px; }
    .facts { border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr; }
    .fact { border-bottom: 1px solid var(--line); padding: 18px 0; }
    .fact:nth-child(odd) { margin-right: 22px; }
    .fact-label { color: var(--muted); display: block; font-size: .7rem; letter-spacing: .1em; margin-bottom: 4px; text-transform: uppercase; }
    .fact-value { font-size: .88rem; font-weight: 800; }

    .project-list { display: grid; gap: 16px; }
    .project {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      display: grid;
      grid-template-columns: 72px 1fr auto;
      gap: 22px;
      align-items: center;
      padding: 24px;
      transition: .2s ease;
    }
    .project:hover { border-color: var(--accent-dark); box-shadow: var(--shadow); transform: translateY(-3px); }
    .project-number { color: var(--accent-dark); font-size: .75rem; font-weight: 900; letter-spacing: .12em; }
    .project h3 { font-size: 1.08rem; margin-bottom: 4px; }
    .project p { color: var(--muted); font-size: .82rem; }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 11px; }
    .tag { background: #edf3e6; border-radius: 5px; color: #5c7440; font-size: .65rem; font-weight: 800; padding: 4px 8px; }
    .project-link { color: var(--accent-dark); font-size: 1.3rem; padding: 10px; }
    .project-link:hover { color: var(--dark); }

    .experience { border-left: 1px solid var(--line); display: grid; gap: 38px; padding-left: 28px; }
    .experience-item { position: relative; }
    .experience-item::before { background: var(--accent); border: 4px solid var(--paper); border-radius: 50%; content: ""; height: 10px; left: -35px; position: absolute; top: 5px; width: 10px; }
    .experience-meta { color: var(--accent-dark); font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    .experience h3 { font-size: 1rem; margin: 7px 0; }
    .experience p { color: var(--muted); font-size: .84rem; max-width: 680px; }

    .skills { display: grid; gap: 12px; grid-template-columns: repeat(4, 1fr); }
    .skill { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 22px 18px; }
    .skill-icon { color: var(--accent-dark); font-size: 1.4rem; margin-bottom: 12px; }
    .skill h3 { font-size: .86rem; margin-bottom: 7px; }
    .skill p { color: var(--muted); font-size: .74rem; }
    .contact { background: var(--dark); border-radius: 30px; color: white; display: grid; grid-template-columns: 1fr auto; gap: 30px; padding: 52px; }
    .contact .eyebrow { color: var(--accent); }
    .contact .eyebrow::before { background: var(--accent); }
    .contact h2 { max-width: 540px; }
    .contact p { color: #aab8ad; margin: 18px 0 0; max-width: 480px; }
    .contact .button { align-self: center; background: var(--accent); border-color: var(--accent); color: var(--dark); white-space: nowrap; }
    .contact .button:hover { background: white; border-color: white; }
    footer { color: var(--muted); font-size: .75rem; padding: 0 64px 34px; text-align: center; }

    @media (max-width: 850px) {
      .page { display: block; }
      .sidebar { display: none; }
      .mobile-bar { align-items: center; background: var(--dark); color: white; display: flex; justify-content: space-between; padding: 15px 20px; position: sticky; top: 0; z-index: 3; }
      .mobile-brand { align-items: center; display: flex; font-size: .85rem; font-weight: 800; gap: 9px; }
      .mobile-brand .monogram { height: 32px; width: 32px; }
      .menu-button { background: none; border: 0; color: white; font-size: 1.5rem; }
      .mobile-menu { background: var(--dark); display: none; padding: 0 20px 15px; }
      .mobile-menu.open { display: grid; }
      .mobile-menu a { color: #bdc9bf; font-size: .78rem; padding: 8px 0; }
      .section { padding: 76px 24px; }
      .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 60px; }
      .hero-art { justify-content: flex-start; margin-top: 20px; }
      .portrait-card { height: 290px; width: 260px; }
      .portrait-card::before { height: 215px; width: 215px; }
      .portrait-initials { font-size: 6.5rem; }
      .about-grid { gap: 30px; grid-template-columns: 1fr; }
      .skills { grid-template-columns: 1fr 1fr; }
      .contact { grid-template-columns: 1fr; padding: 32px 25px; }
      footer { padding: 0 24px 24px; }
    }
    @media (max-width: 520px) {
      h1 { font-size: 3.6rem; }
      .section-heading { align-items: start; display: block; }
      .section-intro { margin-top: 16px; }
      .project { grid-template-columns: 40px 1fr; gap: 13px; padding: 18px; }
      .project-link { display: none; }
      .skills { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="page">
